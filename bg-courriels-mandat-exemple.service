[Unit]
Description=Courriels {{MANDAT_EXEMPLE}} — passerelle entre le tableau de bord et Thunderbird
Documentation="file://{{CHEMIN_INSTALLATION}}/LISEZ-MOI_Courriels_Mandat_Exemple.md"
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Thunderbird est une application graphique : sans DISPLAY, le service tourne
# mais aucune fenêtre n'apparaît, et l'échec est silencieux.
Environment=DISPLAY=:0
ExecStart=/usr/bin/python3 "{{CHEMIN_INSTALLATION}}/courriels_mandat_exemple.py"
# La passerelle est une boucle : si elle tombe (réseau, session graphique
# redémarrée), elle doit revenir seule — sinon un clic sur « ✉ ouvrir »
# resterait sans effet, sans que rien ne le dise.
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
